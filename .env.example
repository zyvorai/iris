# Hermes environment variables — copy to .env and fill in your values.
# The server reads these at startup; no value means the default shown in comments applies.

# ── Server ────────────────────────────────────────────────────────────────────
HERMES_BIND=0.0.0.0:31847          # TCP listen address
HERMES_DB_PATH=/data/hermes/hermes.db  # SQLite database path
HERMES_UI_DIR=./ui/dist             # Built UI asset directory
HERMES_DEFAULT_USER=local           # Username used when auth mode is "none"

# ── Auth ──────────────────────────────────────────────────────────────────────
# HERMES_AUTH_MODE=none             # none | api_key | oidc
# HERMES_API_KEY=                   # Required when mode=api_key
# HERMES_SESSION_SECRET=            # REQUIRED in production — min 32 random chars
                                    # Generate: openssl rand -hex 32

# ── OIDC (required when HERMES_AUTH_MODE=oidc) ────────────────────────────────
# HERMES_OIDC_ISSUER=https://accounts.example.com
# HERMES_OIDC_CLIENT_ID=hermes
# HERMES_OIDC_CLIENT_SECRET=
# HERMES_OIDC_REDIRECT_URL=https://hermes.example.com/auth/callback

# ── Access control ────────────────────────────────────────────────────────────
# HERMES_ALLOWED_NAMESPACES=        # Comma-separated; empty = all namespaces
# HERMES_ADMIN_USERS=alice,bob      # Users with admin privileges
# HERMES_ADMIN_GROUPS=platform-team # Groups with admin privileges

# ── Controller ────────────────────────────────────────────────────────────────
# HERMES_PUBLIC_BASE_URL=http://localhost:31847
# HERMES_PUBLIC_PATH_PREFIX=/launchpad
# HERMES_AUTO_PUBLISH=false         # Auto-publish discovered services
# HERMES_AUTO_SUGGEST=true          # Suggest unpublished services in Discovery
# HERMES_DISCOVER_ALL=true          # Discover services in all namespaces
# HERMES_DISCOVER_INGRESS=true
# HERMES_DISCOVER_GATEWAY_API=true
# HERMES_DISCOVER_MESH=true
# HERMES_WATCH_NAMESPACES=          # Comma-separated; empty = all

# ── Federation ────────────────────────────────────────────────────────────────
# HERMES_FEDERATION_TRUST_HEADERS=false  # Trust x-hermes-user header from peers

# ── Logging ───────────────────────────────────────────────────────────────────
# RUST_LOG=hermes_server=info,tower_http=warn
