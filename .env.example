# Iris environment variables — copy to .env and fill in your values.
# The server reads these at startup; no value means the default shown in comments applies.

# ── Server ────────────────────────────────────────────────────────────────────
IRIS_BIND=0.0.0.0:31847          # TCP listen address
IRIS_DB_PATH=/data/iris/iris.db  # SQLite database path
IRIS_UI_DIR=./ui/dist             # Built UI asset directory
IRIS_DEFAULT_USER=local           # Username used when auth mode is "none"

# ── Auth ──────────────────────────────────────────────────────────────────────
# IRIS_AUTH_MODE=none             # none | api_key | oidc
# IRIS_API_KEY=                   # Required when mode=api_key
# IRIS_SESSION_SECRET=            # REQUIRED in production — min 32 random chars
                                    # Generate: openssl rand -hex 32

# ── OIDC (required when IRIS_AUTH_MODE=oidc) ────────────────────────────────
# IRIS_OIDC_ISSUER=https://accounts.example.com
# IRIS_OIDC_CLIENT_ID=iris
# IRIS_OIDC_CLIENT_SECRET=
# IRIS_OIDC_REDIRECT_URL=https://iris.example.com/auth/callback

# ── Access control ────────────────────────────────────────────────────────────
# IRIS_ALLOWED_NAMESPACES=        # Comma-separated; empty = all namespaces
# IRIS_ADMIN_USERS=alice,bob      # Users with admin privileges
# IRIS_ADMIN_GROUPS=platform-team # Groups with admin privileges

# ── Controller ────────────────────────────────────────────────────────────────
# IRIS_PUBLIC_BASE_URL=http://localhost:31847
# IRIS_PUBLIC_PATH_PREFIX=/launchpad
# IRIS_AUTO_PUBLISH=false         # Auto-publish discovered services
# IRIS_AUTO_SUGGEST=true          # Suggest unpublished services in Discovery
# IRIS_DISCOVER_ALL=true          # Discover services in all namespaces
# IRIS_DISCOVER_INGRESS=true
# IRIS_DISCOVER_GATEWAY_API=true
# IRIS_DISCOVER_MESH=true
# IRIS_WATCH_NAMESPACES=          # Comma-separated; empty = all

# ── Federation ────────────────────────────────────────────────────────────────
# IRIS_FEDERATION_TRUST_HEADERS=false  # Trust x-iris-user header from peers

# ── Zyra AI (optional — rule-based fallback when unset) ───────────────────────
# IRIS_LLM_API_URL=https://api.openai.com/v1
# IRIS_LLM_API_KEY=sk-...
# IRIS_LLM_MODEL=gpt-4o-mini

# ── Logging ───────────────────────────────────────────────────────────────────
# RUST_LOG=iris_server=info,tower_http=warn
